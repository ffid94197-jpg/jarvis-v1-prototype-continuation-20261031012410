# Copy ONLY these optional settings into your private .env, not your API key.
# Preserve your working Gemini API, localhost origin and database values.
# Required local origin for the desktop no-login launcher:
JARVIS_PUBLIC_ORIGIN="http://127.0.0.1:3000"
# An installed Google Gemini-compatible vision model is needed for semantic screen analysis.
JARVIS_SCREEN_WATCH_ENABLED="1"
# Privacy default: images never leave your PC. To allow screen vision to be
# analyzed by your configured external AI API provider, set this to 1 yourself.
JARVIS_SCREEN_VISION_TO_CLOUD="0"
# Optional: app launcher. Must be an operator-chosen absolute path to an .exe.
# JARVIS_TLAUNCHER_PATH="C:\\Path\\To\\TLauncher.exe"
# Optional Minecraft Java runtime. Default is the existing JARVIS/Mineflayer backend.
JARVIS_MINECRAFT_LAN_ENABLED="0"
# Existing Mineflayer backend:
# JARVIS_MINECRAFT_ENGINE="jarvis"
# JARVIS_MINECRAFT_LAN_HOST="127.0.0.1"
# JARVIS_MINECRAFT_LAN_PORT="51234"
# JARVIS_MINECRAFT_PLAYER="YourHumanJavaName"
#
# AI Companion / PlayerEngine backend (Fabric 1.21.11):
# JARVIS_MINECRAFT_ENGINE="ai-companion"
# JARVIS_MINECRAFT_LAN_ENABLED="1"
# JARVIS_MINECRAFT_PLAYER="YourHumanJavaName"
# JARVIS_MINECRAFT_AI_COMPANION_CONFIG="C:\\Path\\To\\MinecraftInstance\\config\\jarvis-bridge.json"
# Optional only when the owner has more than one companion:
# JARVIS_MINECRAFT_AI_COMPANION_NAME="Jarvis"
# AI Companion uses a local token file generated by the Fabric mod and a 127.0.0.1-only HTTP bridge; no LAN port is needed.

# NEW: optional general browser agent tools. Off until explicitly enabled.
# Only affects the dedicated temporary Playwright browser, not your normal Chrome profile.
JARVIS_BROWSER_AGENT_ENABLED="0"
# NEW: allow inspecting/focusing only allowlisted Notepad, Calculator, Explorer, Paint windows.
# Does not grant arbitrary keyboard/mouse input.
JARVIS_WINDOWS_UI_CONTROL_ENABLED="0"
